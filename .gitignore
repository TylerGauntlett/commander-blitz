# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
# Parallel coverage runs leave one data file per process behind.
.coverage.*
htmlcov/

# Training artifacts
runs/
*.pt
*.ckpt

# Node / bun
node_modules/
frontend/dist/
bun.lockb
.vite/
# tsc's incremental cache, written by `tsc --noEmit` in the build script.
frontend/tsconfig.tsbuildinfo

# Storybook
frontend/storybook-static/

# Playwright artifacts
frontend/e2e-report/
frontend/e2e-shots/
frontend/playwright-report/
frontend/test-results/
.playwright/

# Secrets
# Deploy tokens live in .env; .env.example is the committed, valueless template.
.env
*.local.env

# Terraform
# State names live resources and can embed secrets. The lock file is committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent worktrees. Created by parallel capability lanes during a deck import;
# a checkout of this same repo, so committing one would nest the tree in itself.
.claude/worktrees/
# Per-person permission allowlist; Claude Code writes it, nobody shares it.
.claude/settings.local.json
