{
  "name": "commanderblitz-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Commander Blitz client: a four-seat Commander table in the browser.",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:stories:handheld": "vitest run --project=storybook-handheld",
    "test:stories:phone": "vitest run --project=storybook-phone",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "audit:stories": "node scripts/story-layout-audit.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.62.1",
    "storybook": "^10.5.7",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
