{
  "name": "commanderblitz-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Commander Blitz client: a four-seat Commander table in the browser.",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:stories:handheld": "vitest run --project=storybook-handheld",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "audit:stories": "node scripts/story-layout-audit.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^24.1.1",
    "playwright": "^1.62.1",
    "storybook": "^10.5.7",
    "typescript": "^5.5.4",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
