# Deployment credentials. Copy to `.claude/.env` and fill in; it is gitignored
# by the bare-name `.env` rule. See docs/deployment.md.
#
# These are read only by the one-time provisioning steps in docs/deployment.md
# -- `terraform apply` and `gh secret set`. Nothing at runtime reads them, and
# they are never baked into the image or sent to the droplet.

# DigitalOcean personal access token, scoped read + write.
#   https://cloud.digitalocean.com/account/api/tokens
# The `digitalocean` Terraform provider picks this up from the environment, so
# it never has to appear in a .tfvars file or in Terraform state inputs.
DIGITALOCEAN_TOKEN=

# GitHub personal access token, used only to write the repo's Actions secrets.
#   Fine-grained:  Contents r/w, Workflows r/w, Secrets r/w  (on Auto-MTG)
#   Classic:       repo, workflow
# No package scope is needed: the droplet pulls from GHCR using the workflow's
# own GITHUB_TOKEN, not a stored credential.
# The `gh` CLI reads this variable directly.
GH_TOKEN=
