# Runs on the droplet, not here. The deploy job copies this file to
# /opt/automtg/ alongside docker-compose.yml, which bind-mounts it into the
# caddy container.
#
# Caddy terminates TLS for commanderblitz.com and proxies to whichever app
# container is up.
# It obtains the Let's Encrypt certificate itself and renews it on its own
# schedule -- there is no cron job or renewal hook. It also adds the :80 -> :443
# redirect automatically, which is why port 80 must stay open: the ACME HTTP-01
# challenge arrives there.
#
# The certificate and the ACME account key live in the caddy_data volume.
# Losing that volume means re-issuing, and Let's Encrypt rate-limits that.
#
# There is deliberately no catch-all site block, so a request to the bare IP
# gets a "no matching site" 404. That is why CI health-checks the domain.

commanderblitz.com {
	# The SPA bundle is served uncompressed by FastAPI's StaticFiles; this is
	# the cheapest place to fix that.
	encode zstd gzip

	# Both colours on the compose network; the app publishes no host port of
	# its own. `first` sends every request to the first healthy one in this
	# order, so exactly one process answers at any instant (ADR 0023). A
	# request that finds its upstream gone -- the colour a deploy just stopped,
	# or one still booting -- is retried on the other for `lb_try_duration`
	# rather than answered with a 502.
	#
	# The active check is the cheap `/health/live`, at an interval that keeps
	# it off the droplet's CPU graph. The handover in scripts/handover.sh waits
	# two of these intervals before it stops the old colour, so the two move
	# together.
	reverse_proxy web_blue:8000 web_green:8000 {
		lb_policy first
		lb_try_duration 30s
		lb_try_interval 250ms
		fail_duration 10s

		health_uri /health/live
		health_interval 10s
		health_timeout 2s
	}
}
