{
  "card": {
    "id": "coiling_oracle",
    "name": "Coiling Oracle",
    "oracle_text": "When this creature enters, reveal the top card of your library. If it's a land card, put it onto the battlefield. Otherwise, put that card into your hand.",
    "mana_cost": "{G}{U}",
    "types": [
      "Creature"
    ],
    "subtypes": [
      "Snake",
      "Elf",
      "Druid"
    ],
    "power": 1,
    "toughness": 1,
    "colors": [
      "G",
      "U"
    ],
    "color_identity": [
      "G",
      "U"
    ],
    "abilities": [
      {
        "kind": "triggered",
        "text": "When this creature enters, reveal the top card of your library. If it's a land card, put it onto the battlefield. Otherwise, put that card into your hand.",
        "trigger": {
          "event": "self_enters",
          "source": "self"
        },
        "effects": [
          {
            "op": "snapshot",
            "as": "top_card",
            "objects": {
              "zone": "library",
              "controller": "you"
            }
          },
          {
            "op": "reveal",
            "objects": {
              "binding": "top_card"
            }
          },
          {
            "op": "if",
            "condition": {
              "exists": {
                "binding": "top_card",
                "zone": "library",
                "types": [
                  "Land"
                ]
              }
            },
            "then": [
              {
                "op": "put_onto_battlefield",
                "objects": {
                  "binding": "top_card"
                }
              }
            ],
            "else": [
              {
                "op": "return_to_hand",
                "objects": {
                  "binding": "top_card"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "expectation": {
    "zone": "battlefield"
  }
}
