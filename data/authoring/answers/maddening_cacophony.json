    "oracle_text": "Kicker {3}{U}\nEach opponent mills eight cards. If this spell was kicked, instead each opponent mills half their library, rounded up.",
    "mana_cost": "{1}{U}",
    "types": ["Sorcery"],
    "colors": ["U"],
    "color_identity": ["U"],
    "kicker": "{3}{U}",
