        "then": [
          {
            "op": "for_each_player",
            "players": "each_opponent",
            "effects": [
              {
                "op": "mill",
                "player": {"binding": "each_player"},
                "amount": {
                  "half": {
                    "of": {"count": {"zone": "library", "player": {"binding": "each_player"}}},
