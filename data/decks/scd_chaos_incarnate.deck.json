  "tags": [
    "Goad",
    "Punisher",
    "Drain",
    "Burn"
  ],
  "strategy": "Kardur, Doomscourge forces every opponent's creature to attack someone other than you, and every attacking creature that dies drains each opponent for 1, so the deck turns the table on itself and profits from the bloodshed. Geode Rager, Brash Taunter and Hate Mirage keep the fights going, Kazuul, Tyrant of the Cliffs taxes every attack with an Ogre, and Spiteful Visions, Guttersnipe, Thermo-Alchemist, Titan Hunter, Magmatic Force and Stormfist Crusader chip at every life total each turn while Dictate of the Twin Gods doubles it all. Breath of Malfegor, Fiery Confluence, Explosion of Riches and Profane Command close games, Blasphemous Act, Deadly Tempest, Reign of the Pit and Feed the Swarm clear the board, and Sign in Blood, Read the Bones, Bloodgift Demon and Ob Nixilis Reignited keep the cards coming.",
  "archetype": "punisher",
  "ratings": {
    "speed": 3,
    "complexity": 3,
    "interaction": 4,
    "resilience": 2,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "kardur_doomscourge",
      "why": "Until your next turn every opponent's creature must attack a player other than you, and each attacking creature that dies drains every opponent for 1."
    },
    {
      "card_id": "dictate_of_the_twin_gods",
      "why": "Flash in to double all damage, yours and the creatures Kardur sends at your opponents alike."
    },
    {
      "card_id": "spiteful_visions",
      "why": "Every player draws an extra card each draw step, and every card drawn deals 1 damage to its drawer."
    },
    {
      "card_id": "kazuul_tyrant_of_the_cliffs",
      "why": "Each creature that attacks you makes a 3/3 Ogre unless its controller pays {3}."
    }
  ],
