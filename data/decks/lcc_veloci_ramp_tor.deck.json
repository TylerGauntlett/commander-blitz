    "R",
    "W"
  ],
  "source": "precon",
  "release": {
    "set_code": "LCC",
    "set_name": "The Lost Caverns of Ixalan Commander",
    "date": "2023-11-17"
  },
  "notes": "The Lost Caverns of Ixalan Commander precon, card for card (https://mtgjson.com/api/v5/decks/VelociRampTor_LCC.json).",
  "tags": [
    "Dinosaurs",
    "Ramp",
    "Discover",
    "Big Creatures"
  ],
  "strategy": "Pantlaza, Sun-Favored discovers whenever it or another Dinosaur enters, so every big creature brings a free spell with it, and the deck ramps hard to get there: Cultivate, Farseek, Rampant Growth, Topiary Stomper, Thunderherd Migration and Arcane Signet carry it to six and seven mana by the middle turns. Wayta, Trainer Prodigy, Wrathful Raptors, Ripjaw Raptor and Bellowing Aegisaur turn damage dealt to Dinosaurs into card draw, counters and burn, Regisaur Alpha, Thundering Spineback and Rhythm of the Wild hand out haste and size, and Zacama, Primal Calamity, Etali, Primal Storm and Zetalpa, Primal Dawn close the game, with Path to Exile, Generous Gift and Fiery Confluence clearing what stands in the way.",
  "archetype": "tribal",
  "ratings": {
    "speed": 3,
    "complexity": 3,
    "interaction": 2,
    "resilience": 3,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "pantlaza_sun_favored",
      "why": "Every Dinosaur that enters discovers, a free spell off the top."
    },
    {
      "card_id": "wrathful_raptors",
      "why": "Damage dealt to a Dinosaur is dealt back to anything that isn't one."
    },
    {
      "card_id": "regal_behemoth",
      "why": "Makes you the monarch, and every land then taps for an extra mana of any colour."
    },
    {
      "card_id": "zacama_primal_calamity",
      "why": "Untaps your lands as it enters and turns spare mana into removal and life."
    }
  ],
