    "date": "2022-12-02"
  },
  "notes": "Starter Commander Decks precon, card for card (https://mtgjson.com/api/v5/decks/GraveDanger_SCD.json).",
  "tags": [
    "Zombies",
    "Tribal",
    "Graveyard",
    "Reanimation"
  ],
  "strategy": "Gisa and Geralf mill four as they enter and let you cast a Zombie creature from your graveyard each of your turns, so the deck fills its graveyard with Geralf's Mindcrusher, Pilfered Plans, Deep Analysis and Grimoire of the Dead and plays its Zombies twice. Diregraf Captain, Lord of the Accursed, Cemetery Reaper and Liliana's Devotee pump the horde, Champion of the Perished and Unbreathing Horde grow with it, and Vizier of the Scorpion, Lazotep Reaver and Enter the God-Eternals amass a Zombie Army beside it. Gray Merchant of Asphodel, Vela the Night-Clad and Diregraf Captain drain each opponent as Zombies come and go, Gravespawn Sovereign, Necromantic Selection and Victimize steal or return creatures, Zombie Apocalypse returns every Zombie at once and Army of the Damned makes thirteen more, and Murder, Cruel Revival, Crippling Fear and Sinister Sabotage handle what the horde can't outgrow.",
  "archetype": "tribal",
  "ratings": {
    "speed": 2,
    "complexity": 3,
    "interaction": 3,
    "resilience": 4,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "gisa_and_geralf",
      "why": "Mills four as they enter, then lets you cast a Zombie creature from your graveyard each of your turns."
    },
    {
      "card_id": "gravespawn_sovereign",
      "why": "Tap five untapped Zombies to put any creature card from a graveyard onto the battlefield under your control."
    },
    {
      "card_id": "zombie_apocalypse",
      "why": "Every Zombie in your graveyard returns, and every Human dies."
    },
    {
      "card_id": "gray_merchant_of_asphodel",
      "why": "Each opponent loses life equal to your devotion to black, and you gain that much."
    }
  ],
