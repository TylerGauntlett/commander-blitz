{
  "id": "scd_grave_danger",
  "name": "Grave Danger",
  "commanders": [
    "gisa_and_geralf"
  ],
  "color_identity": [
    "B",
    "U"
  ],
  "source": "precon",
  "release": {
    "set_code": "SCD",
