{
  "id": "scd_token_triumph",
  "name": "Token Triumph",
  "commanders": [
    "emmara_soul_of_the_accord"
  ],
  "color_identity": [
    "G",
    "W"
  ],
  "source": "precon",
  "release": {
    "set_code": "SCD",
    "set_name": "Starter Commander Decks",
    "date": "2022-12-02"
  },
  "notes": "Starter Commander Decks precon, card for card (https://mtgjson.com/api/v5/decks/TokenTriumph_SCD.json).",
  "tags": [
    "Tokens",
    "Go wide",
    "Anthems",
    "Convoke"
  ],
  "strategy": "Emmara, Soul of the Accord makes a 1/1 Soldier with lifelink each time she becomes tapped, and the rest of the deck fills the board the same way: Scatter the Seeds, March of the Multitudes, Jade Mage, Selesnya Evangel, Selesnya Guildmage, Verdant Force, Trostani Discordant and Maja, Bretagard Protector all make creatures, and convoke turns that board into mana. Collective Blessing, Dictate of Heliod, Valor in Akros and Overrun make the tokens lethal, Rootborn Defenses and Dauntless Escort protect them from a sweeper, and Camaraderie, Collective Unconscious, Slate of Ancestry and Mentor of the Meek turn the creature count into cards. Path to Exile, Citywide Bust, Aura Mutation and Sylvan Reclamation handle what the tokens cannot.",
  "archetype": "go_wide",
  "ratings": {
    "speed": 3,
    "complexity": 2,
    "interaction": 2,
    "resilience": 3,
    "pilot": 2
  },
  "signature": [
    {
      "card_id": "emmara_soul_of_the_accord",
      "why": "Every time she becomes tapped, attacking included, she makes a 1/1 white Soldier with lifelink, so the board grows every turn she swings."
    },
    {
      "card_id": "march_of_the_multitudes",
      "why": "Convoke with the whole team to make X 1/1 Soldiers with lifelink, often at instant speed at the end of an opponent's turn."
    },
    {
      "card_id": "overrun",
      "why": "Creatures you control get +3/+3 and trample until end of turn, which turns a wide board of tokens into a kill."
    },
    {
      "card_id": "slate_of_ancestry",
      "why": "Discard your hand to draw a card for each creature you control, refilling after the tokens have emptied it."
    }
  ],
