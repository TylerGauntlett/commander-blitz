    "Flying",
    "Go wide",
    "Anthems",
    "Control"
  ],
  "strategy": "Isperia, Supreme Judge flies and draws a card whenever a creature attacks you or a planeswalker you control, so the deck takes to the air and makes attacking it costly. Favorable Winds, Gravitational Shift, Thunderclap Wyvern, Empyrean Eagle and Skycat Sovereign pump every flier, Kangee, Sky Warden, Kangee's Lieutenant and Steel-Plume Marshal grow them as they attack, and True Conviction gives the whole squadron double strike and lifelink. Storm Herd makes a Pegasus for every point of life, Faerie Formation, Moorland Haunt and Inspired Sphinx add more wings, and Aven Gagglemaster, Archon of Redemption and Jubilant Skybonder keep the life total high. Swords to Plowshares, Condemn, Soul Snare, Counterspell, Negate, Time Wipe and Cleansing Nova handle what the fliers can't fly over, and Ever-Watching Threshold, Tide Skimmer and Winged Words keep the cards coming.",
  "archetype": "go_wide",
  "ratings": {
    "speed": 3,
    "complexity": 2,
    "interaction": 4,
    "resilience": 3,
    "pilot": 2
  },
  "signature": [
    {
      "card_id": "isperia_supreme_judge",
      "why": "A flier that draws you a card whenever a creature attacks you or a planeswalker you control."
    },
    {
      "card_id": "storm_herd",
      "why": "Creates a 1/1 flying Pegasus for every point of life you have."
    },
    {
      "card_id": "true_conviction",
      "why": "Every creature you control has double strike and lifelink."
    },
    {
      "card_id": "gravitational_shift",
      "why": "Fliers get +2/+0 and everything on the ground gets -2/-0."
    }
  ],
