    {
      "card_id": "abaddon_the_despoiler",
      "why": "On your turn, every spell from hand cascades if its mana value is at most the life your opponents have lost this turn."
    },
    {
      "card_id": "great_unclean_one",
      "why": "Each opponent loses 2 at your end step, and every one who ends up below you hands you a 1/3 Plaguebearer."
    },
    {
      "card_id": "the_ruinous_powers",
      "why": "Each upkeep it steals the top card of a random opponent's library to play, and makes its owner pay life for it."
    },
    {
      "card_id": "be_lakor_the_dark_master",
      "why": "On arrival it draws a card and costs a life for each Demon you control, and each Demon after it deals its power to any target."
    }
