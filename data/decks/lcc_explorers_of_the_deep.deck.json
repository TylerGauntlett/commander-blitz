    {
      "card_id": "hakbal_of_the_surging_soul",
      "why": "Every combat, each Merfolk you control explores."
    },
    {
      "card_id": "topography_tracker",
      "why": "Every explore happens twice."
    },
    {
      "card_id": "kumena_tyrant_of_orazca",
      "why": "Tap five Merfolk to put a counter on every Merfolk you control."
    },
    {
      "card_id": "herald_of_secret_streams",
      "why": "Creatures with +1/+1 counters can't be blocked."
    }
  ],
