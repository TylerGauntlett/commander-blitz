    {
      "card_id": "ms_bumbleflower",
      "why": "Every spell you cast feeds an opponent a card and grows a flier, and the second each turn draws you two."
    },
    {
      "card_id": "rites_of_flourishing",
      "why": "An extra card and an extra land for everyone, which Bumbleflower and the hand-size payoffs turn into an edge."
    },
    {
      "card_id": "twenty_toed_toad",
      "why": "A maximum hand size of twenty, and twenty cards in hand when it attacks wins the game."
    },
    {
      "card_id": "jolly_gerbils",
      "why": "Every gift you give draws you a card, so the deck's generosity pays for itself."
    }
