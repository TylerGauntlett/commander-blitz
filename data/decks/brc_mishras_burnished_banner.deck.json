  "signature": [
    {
      "card_id": "mishra_eminent_one",
      "why": "At the beginning of combat on your turn, make a hasty token copy of a noncreature artifact you control that is a 4/4 Construct, then sacrifice it at end of turn."
    },
    {
      "card_id": "ashnod_the_uncaring",
      "why": "Every activated ability paid for by sacrificing a permanent can be copied, so each sacrifice outlet does its work twice."
    },
    {
      "card_id": "blast_furnace_hellkite",
      "why": "Artifact offering lets it come down at instant speed for a fraction of its cost, and creatures attacking your opponents have double strike."
    },
    {
      "card_id": "smelting_vat",
      "why": "Sacrifice an artifact to put noncreature artifacts with total mana value up to its own from the top eight onto the battlefield."
    }
  ]
}
