  ],
  "source": "precon",
  "release": {
    "set_code": "MKC",
    "set_name": "Murders at Karlov Manor Commander",
    "date": "2024-02-09"
  },
  "notes": "Murders at Karlov Manor Commander precon, card for card (https://mtgjson.com/api/v5/decks/RevenantRecon_MKC.json).",
  "tags": [
    "Surveil",
    "Reanimation",
    "Graveyard",
    "Removal"
  ],
  "strategy": "Mirko, Obsessive Theorist grows with every surveil and, at each of your end steps, returns a creature card with less power from your graveyard with a finality counter, so the deck fills its graveyard and climbs back out of it. Doom Whisperer, Notion Rain, Discovery // Dispersal, Pile On, Sinister Starfish, Tocasia's Dig Site, Master of Death and the upkeep surveils of Case of the Shifting Visage and Unshakable Tail feed Dimir Spybug, Thoughtbound Phantasm, Copy Catchers, Whispering Snitch and Disinformation Campaign, while Enhanced Surveillance looks deeper and Eye of Duskmantle plays what was binned. Animate Dead, Necromancy, Reanimate and Connive // Concoct bring back Grave Titan, Massacre Wurm and Sphinx of the Second Sun; Ravenous Chupacabra, Shriekmaw, Overseer of the Damned, Price of Fame, Toxic Deluge and Black Sun's Zenith answer the board, and Counterpoint protects it.",
  "archetype": "control",
  "ratings": {
    "speed": 2,
    "complexity": 4,
    "interaction": 3,
    "resilience": 4,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "mirko_obsessive_theorist",
      "why": "Grows with every surveil, and each end step returns a smaller creature card from your graveyard with a finality counter."
    },
    {
      "card_id": "copy_catchers",
      "why": "Each surveil can buy another copy of it."
    },
    {
      "card_id": "eye_of_duskmantle",
      "why": "Cards you surveilled into the graveyard this turn can be played from there, spells paid for in life."
    },
    {
      "card_id": "sphinx_of_the_second_sun",
      "why": "A second beginning phase every turn: another untap, upkeep and draw."
    }
  ],
