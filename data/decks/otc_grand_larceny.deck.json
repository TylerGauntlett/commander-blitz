{
  "id": "otc_grand_larceny",
  "name": "Grand Larceny",
  "commanders": [
    "gonti_canny_acquisitor"
  ],
  "color_identity": [
    "B",
    "G",
    "U"
  ],
  "source": "precon",
  "release": {
    "set_code": "OTC",
    "set_name": "Outlaws of Thunder Junction Commander",
    "date": "2024-04-19"
  },
  "notes": "Outlaws of Thunder Junction Commander precon, card for card (https://mtgjson.com/api/v5/decks/GrandLarceny_OTC.json).",
  "tags": [
    "Theft",
    "Combat damage",
    "Evasion",
    "Ninjutsu"
  ],
  "strategy": "Gonti, Canny Acquisitor makes every spell you cast but don't own cost {1} less, and each time your creatures connect with a player it exiles that player's top card face down for you to play with any mana. So the deck slips small evasive thieves past blockers -- Slither Blade, Triton Shorestalker, Silhana Ledgewalker, Shadowmage Infiltrator, Thief of Sanity, Ukkima -- and ninjutsus Fallen Shinobi, Nashi and Orochi Soul-Reaver in behind them, stealing a card or a creature with every hit. Hostage Taker, Gonti, Lord of Luxury, Siphon Insight, Stolen Goods and Villainous Wealth take from libraries and battlefields directly, Felix Five-Boots doubles every combat-damage trigger, and Thieving Varmint, Savvy Trader and Sage of the Beyond pay for what was taken.",
  "archetype": "control",
  "ratings": {
    "speed": 3,
    "complexity": 4,
    "interaction": 3,
    "resilience": 2,
    "pilot": 4
  },
  "signature": [
    {
      "card_id": "gonti_canny_acquisitor",
      "why": "Stolen spells cost {1} less, and every hit on a player exiles their top card for you to play with any mana."
    },
    {
      "card_id": "felix_five_boots",
      "why": "Every combat-damage trigger your permanents have fires twice, so each connection steals double."
    },
    {
      "card_id": "hostage_taker",
      "why": "Takes a creature or artifact off the table and lets you cast it as your own."
    },
    {
      "card_id": "villainous_wealth",
      "why": "Exiles the top X of an opponent's library and casts every spell of mana value X or less for free."
    }
  ],
