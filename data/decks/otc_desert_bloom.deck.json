{
  "id": "otc_desert_bloom",
  "name": "Desert Bloom",
  "commanders": [
    "yuma_proud_protector"
  ],
  "color_identity": [
    "G",
    "R",
    "W"
  ],
  "source": "precon",
  "release": {
    "set_code": "OTC",
    "set_name": "Outlaws of Thunder Junction Commander",
    "date": "2024-04-19"
  },
  "notes": "Outlaws of Thunder Junction Commander precon, card for card (https://mtgjson.com/api/v5/decks/DesertBloom_OTC.json).",
  "tags": [
    "Lands",
    "Landfall",
    "Graveyard",
    "Tokens"
  ],
  "strategy": "Yuma, Proud Protector gets cheaper with every land card in the graveyard and sacrifices a land to draw each time it enters or attacks, and every Desert that reaches the graveyard -- milled, discarded or sacrificed -- becomes a 4/2 reach Plant Warrior. Dune Chanter makes every land a Desert, Satyr Wayfinder, Eccentric Farmer, World Shaper and The Mending of Dominaria fill the graveyard with lands, and Ramunap Excavator, Perennial Behemoth, Hazezon, Shaper of Sand and Titania, Protector of Argoth bring them back. Explore, Harrow, Hour of Promise and Map the Frontier ramp into the payoffs -- Avenger of Zendikar, Scute Swarm, Nesting Dragon, Sand Scout and Turntimber Sower -- while Ramunap Ruins, Shefet Dunes and Hashep Oasis turn spare Deserts into damage and pumps.",
  "archetype": "landfall",
  "ratings": {
    "speed": 2,
    "complexity": 4,
    "interaction": 2,
    "resilience": 4,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "yuma_proud_protector",
      "why": "Costs {1} less for each land card in your graveyard, makes a 4/2 reach Plant Warrior whenever a Desert hits your graveyard, and sacrifices a land to draw whenever it enters or attacks."
    },
    {
      "card_id": "dune_chanter",
      "why": "Turns every land you control and every land card you own into a Desert, so each one Yuma or Ramunap Ruins sends to the graveyard pays out."
    },
    {
      "card_id": "ramunap_excavator",
      "why": "Replays lands from the graveyard, so a Desert sacrificed for a card comes straight back."
    },
    {
      "card_id": "avenger_of_zendikar",
      "why": "A Plant for every land on arrival, and a counter on each of them with every landfall after."
    }
  ],
