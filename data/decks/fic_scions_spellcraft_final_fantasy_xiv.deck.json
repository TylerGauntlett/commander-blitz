  "signature": [
    {
      "card_id": "y_shtola_night_s_blessed",
      "why": "Drains each opponent for 2 and gains you 2 on every noncreature spell with mana value 3 or greater, and draws a card at each end step once a player has lost 4 or more life that turn."
    },
    {
      "card_id": "papalymo_totolymo",
      "why": "Deals 1 damage to each opponent and gains you 1 life on every noncreature spell, and sacrifices to make each opponent who lost life this turn sacrifice their biggest creature."
    },
    {
      "card_id": "emet_selch_of_the_third_seat",
      "why": "Spells you cast from your graveyard cost {2} less, and once a turn, when opponents lose life, it recasts an instant or sorcery from your graveyard and exiles it after."
    },
    {
      "card_id": "exsanguinate",
      "why": "Drains each opponent for X and gains you all of it, enough on its own to turn on Y'shtola's draw."
    }
  ]
