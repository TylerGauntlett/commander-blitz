{
  "id": "lcc_ahoy_mateys",
  "name": "Ahoy Mateys",
  "commanders": [
    "admiral_brass_unsinkable"
  ],
  "color_identity": [
    "B",
    "R",
    "U"
  ],
  "source": "precon",
  "release": {
    "set_code": "LCC",
    "set_name": "The Lost Caverns of Ixalan Commander",
    "date": "2023-11-17"
  },
  "notes": "The Lost Caverns of Ixalan Commander precon, card for card (https://mtgjson.com/api/v5/decks/AhoyMateys_LCC.json).",
  "tags": [
    "Pirates",
    "Treasure",
    "Theft",
    "Reanimation"
  ],
  "strategy": "Admiral Brass, Unsinkable mills four as it enters and, at the start of every combat, brings a Pirate back from the graveyard as a 4/4 with haste and a finality counter, so the deck fills its own yard with Angrath's Marauders, Hostage Taker and the rest of the crew and keeps attacking with them. Corsair Captain, Gemcutter Buccaneer and Storm Fleet Negotiator pile up Treasure while Breeches, Brazen Plunderer, Don Andres, the Renegade and Coercive Recruiter turn it into the opponents' own cards and creatures, played and swung back at them. Shared Animosity, Herald's Horn and Icon of Ancestry pump the fleet, Port Razer's extra combat phases close the game, and Blasphemous Act, Chaos Warp and Rakdos Charm keep the table honest.",
  "archetype": "tribal",
  "ratings": {
    "speed": 3,
    "complexity": 3,
    "interaction": 2,
    "resilience": 3,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "admiral_brass_unsinkable",
      "why": "Every combat, a Pirate climbs out of the graveyard as a hasty 4/4."
    },
    {
      "card_id": "breeches_brazen_plunderer",
      "why": "Pirate damage exiles the top of each opponent's library for you to play."
    },
    {
      "card_id": "don_andres_the_renegade",
      "why": "Stolen creatures turn into deathtouch Pirates, and stolen spells into Treasure."
    },
    {
      "card_id": "port_razer",
      "why": "Connect once and every creature untaps for another combat."
    }
  ],
