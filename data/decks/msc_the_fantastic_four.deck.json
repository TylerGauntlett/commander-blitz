    "speed": 2,
    "complexity": 4,
    "interaction": 3,
    "resilience": 3,
    "pilot": 4
  },
  "strategy": "Every member of the Fantastic Four wakes up at the beginning of combat if you've cast a noncreature spell this turn: Invisible Woman makes a Wall, Mister Fantastic draws, Human Torch gains flying, double strike and haste, and The Thing takes four +1/+1 counters. So the deck casts a cheap spell before combat every turn, with Valeria Richards making those spells cheaper and drawing on the first, and Cosmic Crucible copying one each turn. Paying {R}{G}{W}{U} on the attack turns each hero into a finisher: an unblockable pump, damage to every opponent, or doubled counters, and Mister Fantastic copies those triggers twice. Cultivate, Three Visits, Farseek and Genesis Ultimatum fix all four colors, First Family refills the hand, Franklin Richards discovers a free spell each combat, and Galactus arrives with Silver Surfer to exile a permanent and keep the table's biggest life total honest.",
  "signature": [
    {
      "card_id": "invisible_woman",
      "why": "A Wall every combat after a noncreature spell, and an unblockable pump for each creature you control."
    },
    {
      "card_id": "the_thing",
      "why": "Four +1/+1 counters each combat, and on the attack doubles every counter on your team."
    },
    {
      "card_id": "valeria_richards_precocious",
      "why": "Noncreature spells cost {1} less, and the first each turn draws a card."
    },
    {
      "card_id": "cosmic_crucible",
      "why": "Four mana in your first main phase and a free copy of a noncreature spell each turn."
    }
  ],
