  "ratings": {
    "speed": 2,
    "complexity": 4,
    "interaction": 4,
    "resilience": 3,
    "pilot": 4
  },
  "strategy": "Jace, Multiverse Architect draws two and bottoms one with his +1, and his -3 exiles one of your own creatures or planeswalkers to reveal the next creature or planeswalker off the top, so the deck is a four-colour pile of big threats that trade up into bigger ones. Mass Polymorph, Synthetic Destiny and Proteus Staff do the same at scale, turning tokens and spent bodies into whatever is next in the library, and Lingering Souls, Secure the Wastes, Grand Crescendo and Martial Coup supply the fodder. Plan for All Outcomes and Fatehold Charm empower a Jace token beside the commander, and opponents have to pay to attack your Jaces. Akroma, Avacyn, Archon of Cruelty and the Overlord of the Mistmoors are what the reveals hope to hit, Signets, Talismans and Chromatic Lantern ramp into them, and Path to Exile, Swords to Plowshares, Despark, Sunfall and White Sun's Twilight answer the table while Teferi's Reproach buys a turn.",
  "signature": [
    {
      "card_id": "jace_multiverse_architect",
      "why": "Card flow on the +1, and the -3 trades a spent body for the next creature or planeswalker in the library."
    },
    {
      "card_id": "mass_polymorph",
      "why": "Every creature you control, tokens included, becomes a fresh creature off the top."
    },
    {
      "card_id": "plan_for_all_outcomes",
      "why": "The first noncreature spell each turn empowers a Jace token, a second walker beside the commander."
    },
    {
      "card_id": "synthetic_destiny",
      "why": "Exile your board now and get back that many creatures from the library at end of turn."
    }
  ],
