  "signature": [
    {
      "card_id": "terra_herald_of_hope",
      "why": "Mills two each combat on your turn, gains flying, and on combat damage pays {2} to return a creature card with power 3 or less to the battlefield tapped."
    },
    {
      "card_id": "general_leo_cristophe",
      "why": "Returns a creature card with mana value 3 or less when it enters, then grows with a +1/+1 counter for each creature you control."
    },
    {
      "card_id": "rise_of_the_dark_realms",
      "why": "Puts every creature card from every graveyard onto the battlefield under your control."
    },
    {
      "card_id": "the_falcon_airship_restored",
      "why": "Sacrifices itself on combat damage to return any creature card from your graveyard, and comes back from the graveyard for {4}{B}."
    }
  ]
