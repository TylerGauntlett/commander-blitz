{
  "id": "dmc_legends_legacy",
  "name": "Legends' Legacy",
  "commanders": [
    "dihada_binder_of_wills"
  ],
  "color_identity": [
    "B",
    "R",
    "W"
  ],
  "source": "precon",
  "release": {
    "set_code": "DMC",
    "set_name": "Dominaria United Commander",
    "date": "2022-09-09"
  },
  "notes": "Dominaria United Commander precon, card for card (https://mtgjson.com/api/v5/decks/LegendsLegacy_DMC.json).",
  "tags": [
    "Legends",
    "Mardu",
    "Combat",
    "Treasure"
  ],
  "strategy": "Dihada, Binder of Wills digs four cards deep for legends and pays Treasure for every miss, and its +2 makes a legendary creature a vigilant, lifelinking, indestructible attacker until your next turn. The deck is almost all legends: Cadric, Soul Kindler copies each one that enters, Shanid, Sleepers' Scourge and The Circle of Loyalty draw or make a Knight for every legendary spell, and Tyrite Sanctum, Sword of the Chosen, Tenza, Godo's Maul and Blackblade Reforged turn whichever one is on the table into the threat. Alesha, Tajic, Neheb, Moira and Bladewing push damage through, Garna and Gerrard's Hourglass Pendant bring back what died this turn, and Kaya's Wrath, Urza's Ruinous Blast, Hero's Downfall and Mortify clear the way.",
  "archetype": "aggro",
  "ratings": {
    "speed": 3,
    "complexity": 3,
    "interaction": 3,
    "resilience": 3,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "dihada_binder_of_wills",
      "why": "Its -3 looks at four cards, keeps every legend and makes a Treasure for each card that misses."
    },
    {
      "card_id": "cadric_soul_kindler",
      "why": "Each other nontoken legend that enters can be copied for {1}, as a hasty token sacrificed at the end step."
    },
    {
      "card_id": "shanid_sleepers_scourge",
      "why": "Every legendary spell or land draws a card, and every other legendary creature gets menace."
    },
    {
      "card_id": "the_circle_of_loyalty",
      "why": "An anthem that gets cheaper with Knights and makes a 2/2 Knight for every legendary spell you cast."
    }
  ],
