    {
      "card_id": "jean_luc_picard_luminary",
      "why": "Draws a card for every big historic permanent you cast, and every second draw grows a creature and charges a Spacecraft."
    },
    {
      "card_id": "tom_paris_risk_taker",
      "why": "Your second draw each turn gives every creature you control flying, double strike, vigilance and haste."
    },
    {
      "card_id": "u_s_s_enterprise_e_sovereign",
      "why": "Enters and destroys every tapped creature, then stations into an 8+ flying, vigilant 7/7."
    },
    {
      "card_id": "howling_mine",
      "why": "Every player draws an extra card each draw step, so every Seek out fires on your own turn."
    }
  ]
