    {
      "card_id": "felothar_the_steadfast",
      "why": "Every creature you control deals damage equal to its toughness and attacks as though it had no defender."
    },
    {
      "card_id": "towering_titan",
      "why": "Enters with a +1/+1 counter for every point of toughness among your other creatures, and a spare wall gives the team trample."
    },
    {
      "card_id": "assault_formation",
      "why": "A second Felothar for toughness damage, and a pump that adds the toughness this deck now swings with."
    },
    {
      "card_id": "slaughter_the_strong",
      "why": "Everyone keeps only 4 total power, and a board of 0-power walls keeps almost everything."
    }
