    {
      "card_id": "hazel_of_the_rootbloom",
      "why": "Every end step copies a token, two when it is a Squirrel, and the tokens tap for any mana she needs."
    },
    {
      "card_id": "chatterfang_squirrel_general",
      "why": "Every token you make brings a Squirrel along, and sacrificing Squirrels shrinks a blocker away."
    },
    {
      "card_id": "zulaport_cutthroat",
      "why": "Each Squirrel that dies drains every opponent, so the sacrifice outlets become a win."
    },
    {
      "card_id": "second_harvest",
      "why": "Copies every token you control at instant speed, doubling the board in one card."
    }
