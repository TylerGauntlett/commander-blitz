      "why": "Attaches an Equipment as it enters, draws a card for each equipped attacking creature, and makes two Treasures when it attacks with power 7 or greater."
    },
    {
      "card_id": "puresteel_paladin",
      "why": "Draws a card whenever an Equipment enters under your control, and with three artifacts every Equipment you control equips for {0}."
    },
    {
      "card_id": "colossus_hammer",
      "why": "+10/+10 for one mana turns any creature into a threat with power 7 or greater; with Puresteel Paladin and three artifacts out, its Equip {8} costs nothing."
    },
    {
      "card_id": "tifa_martial_artist",
      "why": "When a creature with power 7 or greater connects, untaps your creatures and adds a combat phase after the first."
    }
