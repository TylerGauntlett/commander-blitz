  "signature": [
    {
      "card_id": "tidus_yuna_s_guardian",
      "why": "Moves a counter onto the right attacker each combat, then draws and proliferates once a turn when countered creatures connect."
    },
    {
      "card_id": "hardened_scales",
      "why": "Every +1/+1 counter placement gets one more, so support, proliferate and Yuna's two extra counters all grow faster."
    },
    {
      "card_id": "yuna_grand_summoner",
      "why": "Mana that makes the next creature enter with two more counters, and a payoff that turns a dying countered permanent into counters on a survivor."
    },
    {
      "card_id": "damning_verdict",
      "why": "Destroys every creature with no counters on it, which on this board is mostly the opponents'."
    }
  ]
}
