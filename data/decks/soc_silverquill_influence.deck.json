    {
      "card_id": "killian_decisive_mentor",
      "why": "Every enchantment you control that enters taps and goads a creature, and attacks by creatures wearing your Auras draw a card."
    },
    {
      "card_id": "coercive_impetus",
      "why": "Goads the creature it enchants for as long as it stays, and each time that creature attacks you draw a card and lose 1 life."
    },
    {
      "card_id": "eriette_of_the_charmed_apple",
      "why": "Creatures wearing your Auras can't attack you, and each end step drains every opponent for each Aura you control."
    },
    {
      "card_id": "tomik_wielder_of_law",
      "why": "An opponent who swings two or more creatures at you loses 3 life and you draw a card."
    }
  ]
