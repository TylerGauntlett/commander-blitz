  "signature": [
    {
      "card_id": "zurgo_stormrender",
      "why": "Mobilizes a Warrior every attack, and every creature token that leaves draws a card or drains each opponent."
    },
    {
      "card_id": "redoubled_stormsinger",
      "why": "Copies every token that entered this turn, tapped and attacking, so a mobilized Warrior or a fresh Soldier pair arrives twice."
    },
    {
      "card_id": "skullclamp",
      "why": "Equip a 1/1 token and it dies at once for two cards, and Zurgo drains on top."
    },
    {
      "card_id": "hour_of_reckoning",
      "why": "Destroys every nontoken creature, which on this board is mostly the opponents'."
    }
  ]
