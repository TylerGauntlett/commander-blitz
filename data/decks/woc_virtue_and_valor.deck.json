  "notes": "Wilds of Eldraine Commander precon, card for card (https://mtgjson.com/api/v5/decks/VirtueAndValor_WOC.json).",
  "tags": [
    "Auras",
    "Enchantress",
    "Roles",
    "Voltron"
  ],
  "strategy": "Ellivere of the Wild Court puts a Virtuous Role on another creature each time she enters or attacks and draws a card whenever an enchanted creature connects, so the deck dresses its creatures in Auras and Roles and swings: Gylwain, Casting Director and Syr Armont hand out more Roles, Giant Inheritance, Ancestral Mask, Ethereal Armor and Daybreak Coronet make one body enormous, and Snake Umbra, Bear Umbra and Umbra Mystic keep it alive through removal. Setessan Champion, Eidolon of Blossoms, Enchantress's Presence, Sanctum Weaver and Jukai Naturalist turn every enchantment into cards and mana, Kor Spiritdancer and Siona reward each Aura that lands, Timber Paladin and Aura Gnarlid grow with what they wear, and Retether and Unfinished Business bring the Auras back after a wipe, while Swords to Plowshares, Generous Gift, Kenrith's Transformation and Austere Command answer what the Auras cannot race.",
  "archetype": "voltron",
  "ratings": {
    "speed": 3,
    "complexity": 3,
    "interaction": 2,
    "resilience": 3,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "ellivere_of_the_wild_court",
      "why": "Every time she enters or attacks, another creature gets a Virtuous Role, and enchanted creatures that connect draw cards."
    },
    {
      "card_id": "gylwain_casting_director",
      "why": "Each nontoken creature that enters arrives wearing a Royal, Sorcerer or Monster Role."
    },
    {
      "card_id": "setessan_champion",
      "why": "Every enchantment you play grows it and draws a card."
    },
    {
      "card_id": "daybreak_coronet",
      "why": "Two mana for +3/+3, first strike, vigilance and lifelink on a creature that already wears an Aura."
    }
  ],
