    "date": "2023-06-23"
  },
  "notes": "Tales of Middle-earth Commander precon, card for card (https://mtgjson.com/api/v5/decks/RidersOfRohan_LTC.json).",
  "tags": [
    "Humans",
    "Tokens",
    "Monarch",
    "Go wide"
  ],
  "strategy": "Éowyn, Shieldmaiden turns every turn a Human enters into two 2/2 trample, haste Knights at the beginning of combat, and a card once six Humans are out, so the deck floods the board with Humans and swings: Riders of Rohan, Forth Eorlingas, Oath of Eorl, Lossarnach Captain and Increasing Devotion make the bodies, Théoden, King of Rohan hands out double strike as each Human lands, and Shared Animosity and Marshal's Anthem make the crowd hit harder. The crown is the card engine: Éomer, Court of Ire, Archivist of Gondor, Denethor, Throne of the High City and Fealty to the Realm make it the monarch, and a wide board is how it keeps the title. Call for Aid and Zealous Conscripts steal a turn's worth of attackers, while Swords to Plowshares, Path to Exile, Palace Jailer, Banishing Light and Supreme Verdict answer what the swarm cannot race.",
  "archetype": "go_wide",
  "ratings": {
    "speed": 4,
    "complexity": 3,
    "interaction": 3,
    "resilience": 2,
    "pilot": 3
  },
  "signature": [
    {
      "card_id": "eowyn_shieldmaiden",
      "why": "Each turn another Human enters, combat starts with two 2/2 trample, haste Knights, and a card once six Humans are out."
    },
    {
      "card_id": "theoden_king_of_rohan",
      "why": "Every Human that enters hands double strike to a creature for the turn."
    },
    {
      "card_id": "forth_eorlingas",
      "why": "X hasty Knights, and the crown for any of them that connects."
    },
    {
      "card_id": "shared_animosity",
      "why": "A swing of Humans pumps every attacker by the number of others beside it."
    }
  ],
